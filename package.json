{
  "name": "salary-management",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @salary-management/web",
    "dev:api": "npm run dev -w @salary-management/api",
    "build": "npm run db:generate && npm run build -w @salary-management/shared && npm run build -w @salary-management/api && npm run build -w @salary-management/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test:api": "npm run test -w @salary-management/api",
    "test:web": "npm run test -w @salary-management/web"
  },
  "devDependencies": {
    "@prisma/client": "^6.8.2",
    "@types/node": "^22.15.21",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
